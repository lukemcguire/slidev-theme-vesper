{
  "name": "slidev-theme-vesper",
  "version": "0.2.0",
  "description": "A Slidev theme with Catppuccin Mocha/Latte palette, structured layouts, and technical documentation styling",
  "keywords": [
    "slidev-theme",
    "catppuccin",
    "dark-mode",
    "technical",
    "documentation"
  ],
  "homepage": "https://github.com/luke-mcguire/slidev-theme-vesper",
  "author": "luke.mcguire@gmail.com",
  "scripts": {
    "dev": "slidev example.md",
    "build": "slidev build example.md",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "layouts/",
    "components/",
    "styles/",
    "setup/",
    "assets/",
    "example.md",
    "vite.config.ts",
    "README.md"
  ],
  "devDependencies": {
    "@slidev/cli": "52.15.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "vue": "^3.5.24"
  },
  "slidev": {
    "highlighter": "shiki",
    "defaults": {
      "canvasWidth": 960,
      "lineNumbers": true,
      "comark": true,
      "mermaid": {
        "theme": "base",
        "fontFamily": "'Fira Code', monospace",
        "themeVariables": {
          "background": "#1e1e2e",
          "primaryColor": "#313244",
          "primaryTextColor": "#cdd6f4",
          "primaryBorderColor": "#585b70",
          "secondaryColor": "#181825",
          "tertiaryColor": "#1e1e2e",
          "lineColor": "#cba6f7",
          "mainBkg": "#313244",
          "nodeBorder": "#585b70",
          "clusterBkg": "#181825",
          "titleColor": "#cdd6f4",
          "edgeLabelBackground": "#1e1e2e",
          "pie1": "#cba6f7",
          "pie2": "#89b4fa",
          "pie3": "#a6e3a1",
          "pie4": "#f9e2af",
          "pie5": "#f38ba8",
          "pie6": "#94e2d5",
          "xyChart": {
            "backgroundColor": "transparent",
            "plotColorPalette": "#89b4fa,#cba6f7,#a6e3a1,#f9e2af,#f38ba8,#94e2d5"
          },
          "pieStrokeColor": "#1e1e2e",
          "pieLegendTextColor": "#cdd6f4",
          "pieTitleTextColor": "#cdd6f4",
          "pieSectionTextColor": "#1e1e2e"
        }
      }
    }
  }
}
